#include <Arduino.h>

#define ADC_PIN 34  // Pin ADC (Microfono)
#define DAC_PIN 25  // Pin DAC (Parlante)
#define FS 10000    // Frecuencia de muestreo a 10 kHz
#define N 81        // Orden del filtro

// Coeficientes FIR con ventana de Kaiser para un pasa banda de 250 a 500 Hz
float h[N] = {
    -6.202620586622496e-21, -7.769326541160846e-06, -2.4409793716885548e-05, -4.899448159254668e-05, -7.460539172299248e-05,
    -8.587995534438751e-05, -5.7596782374325565e-05, 4.481925145693649e-05, 0.0002621137691822968, 0.0006349213269387628,
    0.0011945075529761339, 0.0019513408765561653, 0.002883017841939555, 0.0039236786385039545, 0.004957406899424651,
    0.005818078824693671, 0.006297628460878636, 0.0061637194090421125, 0.00518643788332165, 0.0031720162334915327,
